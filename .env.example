# --- Required (nothing works without these) ---
NEXT_PUBLIC_SUPABASE_URL=               # Supabase dashboard -> Project Settings -> API
SUPABASE_SERVICE_ROLE_KEY=             # Same location -- NEVER expose to browser

# --- Google Calendar (optional -- bookings save without it) ---
GOOGLE_CLIENT_ID=                       # Google Cloud Console -> Credentials
GOOGLE_CLIENT_SECRET=                   # Same location
GOOGLE_REFRESH_TOKEN=                   # Run: npm run google-token
BOOKING_CALENDAR_ID=                    # Calendar where events are created
SCHOOL_CALENDAR_ID=                     # Optional: blocks availability only
WORK_CALENDAR_ID=                       # Optional: blocks availability only
PERSONAL_CALENDAR_ID=                   # Optional: blocks availability only

# --- Resend / Email (optional -- bookings save without it) ---
RESEND_API_KEY=                         # resend.com -> API Keys
FROM_EMAIL=                             # Leave blank for sandbox mode
OWNER_NOTIFICATION_EMAIL=               # Where booking/cancel/reschedule alerts go -- falls back to business.email

# --- Stripe Payments (optional -- redirects to Checkout when configured) ---
STRIPE_SECRET_KEY=                      # Stripe Developers -> API keys -> Secret key
STRIPE_WEBHOOK_SECRET=                  # Stripe webhook signing secret for /api/webhooks/stripe

# --- Twilio SMS (optional -- sends texts when configured) ---
TWILIO_ACCOUNT_SID=                     # Twilio Console -> Account SID
TWILIO_AUTH_TOKEN=                      # Twilio Console -> Auth Token
TWILIO_MESSAGING_SERVICE_SID=           # Preferred for A2P 10DLC messaging
TWILIO_FROM_PHONE=                      # Fallback if no messaging service SID, e.g. +13125551234

# --- App ---
NEXT_PUBLIC_SITE_URL=http://localhost:3000
TRAINER_PHONE=                          # For admin notifications (shop phone)
CRON_SECRET=                            # Random 16+ char string for cron auth
